{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "KBR_ENABLE_ASAN": "OFF",
        "KBR_ENABLE_FUZZING": "OFF",
        "KBR_ENABLE_THIRDPARTY_INSTRUMENTATION": "OFF"
      }
    },
    {
      "name": "vs2026",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2026"
    },
    {
      "name": "vs2022",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2022"
    },
    {
      "name": "ninja-msvc-debug",
      "inherits": "windows-base",
      "displayName": "Ninja + MSVC (Debug)",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-release",
