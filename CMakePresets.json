{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "build/vs2022"
    },
    {
      "name": "vs2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "build/vs2026",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KBR_ENABLE_ASAN": "OFF",
        "KBR_ENABLE_FUZZING": "OFF",
        "KBR_ENABLE_THIRDPARTY_INSTRUMENTATION": "OFF"
      }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC (Debug)",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC (Release)",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-clang-debug",
      "displayName": "Ninja (Clang-CL Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "vs2026-asan",
      "inherits": "vs2026",
      "binaryDir": "build/vs2026-asan",
      "cacheVariables": {
        "KBR_ENABLE_ASAN": "ON",
        "KBR_ENABLE_FUZZING": "OFF",
        "KBR_ENABLE_THIRDPARTY_INSTRUMENTATION": "OFF"
      }
    }
  ]
}
