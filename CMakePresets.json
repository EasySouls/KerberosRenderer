    },
    {
      "name": "vs2026-asan",
      "inherits": "vs2026",
      "binaryDir": "${sourceDir}/out/build/vs2026-asan",
      "cacheVariables": {
        "KBR_ENABLE_ASAN": "ON",
        "KBR_ENABLE_FUZZING": "OFF",
        "KBR_ENABLE_THIRDPARTY_INSTRUMENTATION": "OFF"
      }
    }
